{
  "title": "ENETS / GEP-NEN classification rules",
  "version": 1,
  "description": "Transparent rules used by OVIS to classify GEP-NET, GEP-NEC, MiNEN and cases requiring review.",
  "matching": {
    "operator": "topographyPrefix AND completeMorphologyCode",
    "topographyField": "ICDO_localizationCode",
    "morphologyField": "ICDO_histologyCode",
    "histologySources": [
      "diagnosis",
      "pathology"
    ],
    "pathologyTopographyFallback": "If a pathology record has no topography, the diagnosis topography of the same tumour is used."
  },
