{
	"name": "app",
	"version": "1.0.0",
	"description": "an graphQl server for mongo",
	"main": "index.js",
	"scripts": {
		"test:security": "node --test accessControl.test.js",
		"test": "echo \"Error: no test specified\" && exit 1",
		"test:ast": "node --test astUtils.test.js astTranslator.test.js resolver/studyPatientTable.test.js runtimeIndexes.test.js differential/referenceEvaluator.test.mjs",
		"test:ast-reference": "node --test differential/referenceEvaluator.test.mjs",
		"test:ast-differential": "node differential/omockAstDifferential.mjs",
		"test:cox": "node --test resolver/cox.test.js resolver/coxData.test.js resolver/coxService.test.js",
		"format": "prettier --config ../../.prettierrc.cjs --ignore-path ../../.prettierignore --write \"*.js\" \"*.mjs\" \"resolver/**/*.js\"",
		"format:check": "prettier --config ../../.prettierrc.cjs --ignore-path ../../.prettierignore --check \"*.js\" \"*.mjs\" \"resolver/**/*.js\""
	},
	"keywords": [
		"mongo",
		"grapQl"
	],
	"author": "jordan",
	"license": "ISC",
	"devDependencies": {
		"prettier": "^2.8.8"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express4": "^1.1.2",
		"cors": "^2.8.6",
		"express": "^4.22.3",
		"graphql": "^16.14.2",
		"mongodb": "^6.2.0"
	},
	"engines": {
		"node": ">=20"
	}
}
